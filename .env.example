# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# FRED (Federal Reserve macro data: rates, inflation, labor, growth). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Optional: a custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp,
# relay). Select provider "openai_compatible" and set the base URL; the key is
# optional (local servers need none).
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (provider "bedrock", install with: pip install ".[bedrock]").
# Auth: either a Bedrock API key (bearer token, no AWS access keys) OR the AWS
# credential chain (env keys / ~/.aws/credentials / IAM role / AWS_PROFILE). Set
# the region either way; a bearer token takes precedence when both are present.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# In the CLI, setting the LLM provider / models / backend URL / language
# also skips the matching interactive selection step (useful for
# OpenAI-compatible endpoints like opencode or LM Studio, and unattended runs).
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
# Sampling temperature (lower = less run-to-run variation on models that
# honor it). Unset leaves each provider at its default. See the README
# "Reproducibility" note — no setting makes LLM output fully deterministic.
#TRADINGAGENTS_TEMPERATURE=0.0
# LLM SDK retry budget forwarded to every provider. Unset leaves each SDK at its
# own default (usually 2). Raise it to ride out bursty 429 rate-limit throttling
# on rate-limited deployments (e.g. Azure OpenAI) instead of aborting the run.
#TRADINGAGENTS_LLM_MAX_RETRIES=6
# Cap on output tokens forwarded to every provider (Gemini's max_output_tokens
# too). Unset leaves each provider at its default. Set it to bound a model that
# emits unbounded reasoning/output and hangs or trips a gateway idle timeout.
#TRADINGAGENTS_MAX_TOKENS=8192
# Provider-specific reasoning/thinking depth (optional; unset = provider
# default). Setting one also skips the matching interactive prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high

# --- SURVIVOR (autonomous PAPER trading & learning engine) -------------------
# Central inference provider: one OpenRouter key runs the whole research run.
# Get a key: https://openrouter.ai/keys  (keys look like sk-or-v1-...)
# OPENROUTER_API_KEY= is listed above; paste your real key into your local
# `.env` (never commit it).

# Exact OpenRouter model ID (provider/model slug from https://openrouter.ai/models)
SURVIVOR_OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Optional stronger model for research manager / trader / portfolio manager
#SURVIVOR_OPENROUTER_STRONG_MODEL=
# Explicit USD pricing per 1M tokens for the configured model, "<input>,<output>".
# REQUIRED (fail-closed): routing refuses to run an unpriced model.
SURVIVOR_OPENROUTER_PRICING=0.05,0.20

# Survivor control plane: guarded inference (ModelRouter + budget enforcement)
TRADINGAGENTS_SURVIVOR_ENABLED=true
# Autonomous PAPER cycle loop (market scan -> research -> risk -> paper broker)
TRADINGAGENTS_SURVIVOR_AUTONOMY_ENABLED=true
# DRY RUN: scan + research + risk, but zero paper executions
SURVIVOR_DRY_RUN=true

# FX rate used to convert provider spend into the GBP budget ledger (USD per GBP)
#SURVIVOR_USD_GBP_RATE=1.30
# Budget ceilings in GBP (already conservative; lowering is always safe)
#SURVIVOR_GLOBAL_DAILY_GBP=1.70
#SURVIVOR_GLOBAL_MONTHLY_GBP=50.00

# --- JARVIS WORLD INTELLIGENCE (optional, fail-open) -------------------------
# Fetch a bounded intelligence digest from the Jarvis World endpoint and fold it
# into the SURVIVOR research context BEFORE the research/decision cycle. Jarvis
# is strictly an enrichment: if it is offline / disabled / unconfigured / times
# out / returns malformed data or 401/403, the existing SURVIVOR flow runs
# unchanged (no crash, no retry storm). No secrets are required here.
JARVIS_BASE_URL=http://localhost:8000
JARVIS_INTELLIGENCE_ENABLED=true
JARVIS_INTELLIGENCE_TIMEOUT_SECONDS=5
# Max analyses introspected; hard-clamped to 10 regardless.
JARVIS_INTELLIGENCE_LIMIT=10

# --- LLM COST GOVERNOR -----------------------------------------------------
# One hard cost-control layer for every autonomous model call. Keep these LOW —
# they are the guard rails against runaway token/cost usage. A background
# process should never casually send millions of tokens in one request.
# Kill switch: false => ZERO background/autonomous LLM calls (deterministic
# collection/analysis continues; paper state continues).
LLM_AUTONOMY_ENABLED=true
# Hard per-call context cap (tokens). Oversized contexts are REFUSED, not sent.
LLM_MAX_INPUT_TOKENS_PER_CALL=12000
# Per-call output cap (tokens).
LLM_MAX_OUTPUT_TOKENS_PER_CALL=2000
# Call-rate caps — bound the agent/tool loop.
LLM_MAX_CALLS_PER_MINUTE=10
LLM_MAX_CALLS_PER_HOUR=60
# Daily USD budget for autonomous/background calls.
AUTONOMOUS_LLM_DAILY_BUDGET_USD=0.50
# Re-analyze the SAME unchanged decision-time snapshot no more than once per
# window (hours). Identical state in the window is served from cache, zero calls.
#SURVIVOR_RESEARCH_COOLDOWN_HOURS=24
